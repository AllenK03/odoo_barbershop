<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista / Tree -->
    <record id="view_barber_service_tree" model="ir.ui.view">
        <field name="name">barber.service.tree</field>
        <field name="model">barber.service</field>
        <field name="arch" type="xml">
            <tree string="Servicios">
                <field name="name" />
                <field name="price" widget="monetary" />
                <field name="duration" />
                <field name="custom_commission" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_barber_service_form" model="ir.ui.view">
        <field name="name">barber.service.form</field>
        <field name="model">barber.service</field>
        <field name="arch" type="xml">
            <form string="Servicio de Barbería">
                <sheet>
                    <group>
                        <group string="Detalles del Servicio">
                            <field name="name" />
                            <field name="price" />
                            <field name="duration" />
                        </group>
                        <group string="Configuración de Comisión">
                            <field name="custom_commission" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_barber_service" model="ir.actions.act_window">
        <field name="name">Catálogo de Servicios</field>
        <field name="res_model">barber.service</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>